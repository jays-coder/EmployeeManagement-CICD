@model EmployeeManagement.Models.Employee
@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">

    <div class="card">

        <div class="card-header">
            <h4 class="mb-0">Employee Details</h4>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Employee ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@Model.Department</dd>

                <dt class="col-sm-3">Designation</dt>
                <dd class="col-sm-9">@Model.Designation</dd>

                <dt class="col-sm-3">Salary</dt>
                <dd class="col-sm-9">
                    ₹ @Model.Salary.ToString("N2")
                </dd>

                <dt class="col-sm-3">Joining Date</dt>
                <dd class="col-sm-9">
                    @Model.JoiningDate.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

            </dl>

            <div class="mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>

